# Dependencies
/node_modules/
/.pnp/
.pnp.*
/.pnpm-store/
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Next.js build output and generated types
/.next/
/.next-*/
/out/
/build/
/dist/
next-env.d.ts
*.tsbuildinfo

# Test and analysis output
/coverage/
/playwright-report/
/test-results/
/blob-report/
/.nyc_output/

# Tool caches
/.cache/
/.turbo/
/.swc/
.eslintcache
.stylelintcache

# Environment files (keep the documented template)
.env*
!.env.example
*.local

# Logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Deployment metadata
/.vercel/

# Local certificates and keys
*.pem
*.key
*.p12

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editors and IDEs
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary files
*.tmp
*.temp
*.bak
*.orig
*~
